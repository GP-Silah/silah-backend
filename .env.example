# This database connection string will be used by prisma in prisma/schema.prisma
# There are many types of connection strings read prisma docs to learn more
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}?schema=public"

# These are docker environment variables
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secret
POSTGRES_DB_DEV=db_dev
POSTGRES_DB_TEST=db_test

# Set this to development or production
NODE_ENV=development

# Set the App Port
PORT=3000

# Use this to set the frontend port
FRONTEND_PORT=5173
# Use this to set the frontend url -> will be used to store cookies and send links to the email 
FRONTEND_URL="http://localhost:5173"
# These will have CORS enabiled
FRONTEND_CORS="https://silah.site,https://www.silah.site,http://localhost:5173"

# Use this to set the ai backend port
AI_BACKEND_PORT=8000
# Use this to set the ai backend url
AI_BACKEND_URL="http://localhost:8000"

# Use this to set the secret that will be used by jwt to generate the tokens
JWT_SECRET="yoursecret"

# These will be used to send emails by nodemailer (OLD CODE used it, but after deployment we couldn't sned emails through the port from our server thus we moved to SendGrid API)
# Make sure to use the correct host, port, user and password for your email service
# If you are using a privteemail account from namecheap, you can use the following settings:
MAIL_HOST="mail.privateemail.com"
MAIL_PORT=587
# Mail secure should be true for port 465, false for other ports
MAIL_SECURE=false
MAIL_USER="youremail@domain.com"
MAIL_PASS="yourpassword"

# These will be used to send emails through SendGrid API
SENDGRID_API_KEY="here"

# These will be used to connect with CloudFlare R2 storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=xxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxx
R2_BUCKET_NAME=my-bucket

# These will be used to connect with Tap Payments Gateway
TAP_SECRET_KEY="sk_test_xxxxx"
TAP_MERCHANT_ID="0000"

# This will be used to connect with DeepL translation service API
DEEPL_API_KEY="here"

# These will be used to retrieve access token from Wathq API
WATHQ_CONSUMER_KEY="xxxxxxxxxxxxxxxxxxxxx"
WATHQ_CONSUMER_SECRET="yyyyyyyyy"

