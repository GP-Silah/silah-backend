generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  crn               String         @unique
  password          String
  name              String
  city              String
  nid               String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  businessName      String
  agreedToTerms     Boolean        @default(true)
  isEmailVerified   Boolean        @default(false)
  role              UserRole       @default(BUYER)
  pfpFileName       String?
  isPfpDefault      Boolean        @default(true)
  tapCustomerId     String         @unique
  preferredLanguage Languages      @default(EN)
  buyer             Buyer?
  supplier          Supplier?
  categories        UserCategory[]
}

model Supplier {
  id                  String                     @id @default(uuid())
  userId              String                     @unique
  plan                SupplierPlan               @default(BASIC)
  isStoreClosed       Boolean                    @default(true)
  storeClosedMsg      String                     @default("This store is currently closed. Please check back later.")
  storeBio            String?
  deliveryFees        Float                      @default(0.0)
  avgRating           Float                      @default(0.0)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  storeBannerFileName String?
  status              SupplierStatus             @default(ACTIVE)
  ratingsCount        Int                        @default(0)
  usedFreeTrail       Boolean                    @default(false)
  deletedAt           DateTime?
  isDeleted           Boolean                    @default(false)
  cartGroups          CartBySupplier[]
  invoices            Invoice[]
  ordersReceived      Order[]
  preInvoices         PreInvoice[]
  products            Product[]
  recievedReviews     Review[]
  services            Service[]
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories          SupplierFavoriteCategory[]
  subscriptions       SupplierSubscription[]
}

model SupplierSubscription {
  id         String   @id @default(uuid())
  supplierId String
  startDate  DateTime @default(now())
  endDate    DateTime @default(dbgenerated("(now() + '1 mon'::interval)"))
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Buyer {
  id                  String       @id @default(uuid())
  userId              String       @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  card                Card?
  carts               Cart[]
  invoices            Invoice[]
  writtenItemsReviews ItemReview[]
  orders              Order[]
  preInvoices         PreInvoice[]
  writtenReviews      Review[]
  wishlist            Wishlist[]
}

model Card {
  id             String   @id @default(uuid())
  tapCardId      String   @unique
  buyerId        String   @unique
  cardHolderName String
  last4          String
  brand          String
  expMonth       String
  expYear        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  buyer          Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
}

model Category {
  id               Int                        @id @default(autoincrement())
  name             String                     @unique
  parentCategoryId Int?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  usedFor          ItemType
  parentCategory   Category?                  @relation("CategoryToSubcategories", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subcategories    Category[]                 @relation("CategoryToSubcategories")
  products         Product[]
  services         Service[]
  suppliers        SupplierFavoriteCategory[]
  users            UserCategory[]
}

model UserCategory {
  userId     String
  categoryId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
}

model SupplierFavoriteCategory {
  supplierId String
  categoryId Int
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([supplierId, categoryId])
}

model Product {
  id                    String                 @id @default(uuid())
  supplierId            String?
  name                  String                 @db.VarChar(60)
  description           String                 @db.VarChar(1000)
  price                 Float
  stock                 Int                    @default(0)
  categoryId            Int
  imagesFilesNames      String[]
  caseQuantity          Int                    @default(1)
  minOrderQuantity      Int                    @default(1)
  maxOrderQuantity      Int?
  allowGroupPurchase    Boolean                @default(false)
  minGroupOrderQuantity Int?
  groupPurchasePrice    Float?
  groupPurchaseDuration GroupPurchaseDeadline?
  isPublished           Boolean                @default(false)
  wishlistCount         Int                    @default(0)
  avgRating             Float                  @default(0.0)
  ratingsCount          Int                    @default(0)
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cartItems             CartItem[]
  invoiceItems          InvoiceItem[]
  orderItems            OrderItem[]
  preInoivces           PreInvoice[]
  category              Category               @relation(fields: [categoryId], references: [id])
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
}

model Service {
  id                  String              @id @default(uuid())
  supplierId          String?
  name                String              @db.VarChar(60)
  description         String              @db.VarChar(1000)
  price               Float
  isPriceNegotiable   Boolean             @default(false)
  categoryId          Int
  imagesFilesNames    String[]
  serviceAvailability ServiceAvailability
  isPublished         Boolean             @default(false)
  wishlistCount       Int                 @default(0)
  avgRating           Float               @default(0.0)
  ratingsCount        Int                 @default(0)
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  invoiceItems        InvoiceItem[]
  category            Category            @relation(fields: [categoryId], references: [id])
  supplier            Supplier?           @relation(fields: [supplierId], references: [id])
}

model ItemEmbedding {
  id        String   @id @default(uuid())
  itemId    String
  itemType  ItemType
  embedding Float[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, itemType])
}

model Cart {
  id            String           @id @default(uuid())
  buyerId       String
  productsTotal Float
  deliveryFees  Float
  cartTotal     Float
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  isBought      Boolean          @default(false)
  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?
  buyer         Buyer            @relation(fields: [buyerId], references: [id])
  suppliers     CartBySupplier[]
  orders        Order[]
}

model CartBySupplier {
  id                 String     @id @default(uuid())
  cartId             String
  supplierId         String
  deliveryFee        Float
  subTotal           Float
  supplierTotalPrice Float
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  cart               Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  supplier           Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
}

model CartItem {
  id               Int            @id @default(autoincrement())
  cartBySupplierId String
  productId        String
  quantity         Int
  itemTotalPrice   Float
  cartBySupplier   CartBySupplier @relation(fields: [cartBySupplierId], references: [id], onDelete: Cascade)
  product          Product        @relation(fields: [productId], references: [id])
}

model Order {
  id          String      @id @default(uuid())
  buyerId     String?
  cartId      String
  supplierId  String
  finalPrice  Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  tapChargeId String
  buyer       Buyer?      @relation(fields: [buyerId], references: [id])
  cart        Cart        @relation(fields: [cartId], references: [id])
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  items       OrderItem[]
  review      Review?
}

model OrderItem {
  id         Int         @id @default(autoincrement())
  orderId    String
  productId  String?
  quantity   Int         @default(1)
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime    @default(now())
  itemReview ItemReview?
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id])
}

model Invoice {
  id                    String                @id @default(uuid())
  buyerId               String?
  supplierId            String?
  deliveryDate          DateTime
  termsOfPayment        InvoiceTermsOfPayment
  upfrontAmount         Float?
  tapChargeIdForUpfront String?
  tapChargeId           String?
  uponDeliveryAmount    Float
  amount                Float
  notesAndTerms         String?
  status                InvoiceStatus         @default(PENDING)
  createdAt             DateTime              @default(now())
  buyer                 Buyer?                @relation(fields: [buyerId], references: [id])
  supplier              Supplier?             @relation(fields: [supplierId], references: [id])
  items                 InvoiceItem[]
  preInvoice            PreInvoice?
  review                Review?
}

model InvoiceItem {
  id                 Int         @id @default(autoincrement())
  invoiceId          String
  name               String      @db.VarChar(60)
  description        String      @db.VarChar(100)
  agreedDetails      String      @db.VarChar(100)
  quantity           Int
  unitPrice          Float
  priceBasedQuantity Float
  relatedServiceId   String?
  relatedProductId   String?
  invoice            Invoice     @relation(fields: [invoiceId], references: [id])
  relatedProduct     Product?    @relation(fields: [relatedProductId], references: [id])
  relatedService     Service?    @relation(fields: [relatedServiceId], references: [id])
  itemReview         ItemReview?
}

model PreInvoice {
  id              String           @id @default(uuid())
  invoiceId       String?          @unique
  groupPurchaseId String?
  buyerId         String?
  supplierId      String?
  productId       String?
  amount          Float
  status          PreInvoiceStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  buyer           Buyer?           @relation(fields: [buyerId], references: [id])
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  product         Product?         @relation(fields: [productId], references: [id])
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
}

model Review {
  id                      String       @id @default(uuid())
  orderId                 String?      @unique
  invoiceId               String?      @unique
  buyerId                 String?
  supplierId              String?
  supplierRating          Int          @default(5)
  writtenReviewOfSupplier String?      @db.VarChar(150)
  createdAt               DateTime     @default(now())
  itemsReview             ItemReview[]
  buyer                   Buyer?       @relation(fields: [buyerId], references: [id])
  invoice                 Invoice?     @relation(fields: [invoiceId], references: [id])
  order                   Order?       @relation(fields: [orderId], references: [id])
  supplier                Supplier?    @relation(fields: [supplierId], references: [id])
}

model ItemReview {
  id                  Int          @id @default(autoincrement())
  reviewId            String
  orderItemId         Int?         @unique
  invoiceItemId       Int?         @unique
  buyerId             String?
  itemRating          Int          @default(5)
  writtenReviewOfItem String?      @db.VarChar(150)
  createdAt           DateTime     @default(now())
  buyer               Buyer?       @relation(fields: [buyerId], references: [id])
  invoiceItem         InvoiceItem? @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)
  orderItem           OrderItem?   @relation(fields: [orderItemId], references: [id])
  review              Review       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(uuid())
  buyerId   String
  itemId    String
  itemType  ItemType
  createdAt DateTime @default(now())
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([buyerId, itemId, itemType])
}

enum UserRole {
  GUEST
  SUPPLIER
  BUYER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TOKEN
}

enum Languages {
  AR
  EN
}

enum SupplierPlan {
  BASIC
  PREMIUM
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum StoreStatus {
  OPEN
  CLOSED
}

enum GroupPurchaseDeadline {
  THREE_DAYS
  FIVE_DAYS
  SEVEN_DAYS
}

enum ServiceAvailability {
  TWENTY_FOUR_SEVEN
  EVERYDAY
  WEEKDAYS
  WEEKENDS
  APPOINTMENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
}

enum PreInvoiceStatus {
  PENDING
  FAILED
  SUCCESSFUL
}

enum InvoiceStatus {
  PENDING
  ACCEPTED
  REJECTED
  FULLY_PAID
  PARTIALLY_PAID
}

enum InvoiceTermsOfPayment {
  PARTIAL
  FULL
}
