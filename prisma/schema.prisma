// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============  👤 USER ================
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  crn             String   @unique
  password        String
  name            String
  role            UserRole @default(BUYER)
  businessName    String
  city            String
  nid             String   @unique
  agreedToTerms   Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  pfpFileName     String?
  isPfpDefault    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tapCustomerId   String   @unique

  categories UserCategory[]
  supplier   Supplier?
  buyer      Buyer?
}

// ============ 🛢 SUPPLIER ==============
model Supplier {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  plan                SupplierPlan   @default(BASIC)
  status              SupplierStatus @default(ACTIVE)
  usedFreeTrail       Boolean        @default(false)
  isStoreClosed       Boolean        @default(true)
  storeClosedMsg      String         @default("This store is currently closed. Please check back later.")
  storeBio            String?
  storeBannerFileName String?
  deliveryFees        Float          @default(0.0)
  avgRating           Float          @default(0.0)
  ratingsCount        Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  categories    SupplierFavoriteCategory[]
  subscriptions SupplierSubscription[]
  products      Product[]
  services      Service[]
}

// ============ 🛂 SUBSCRIPTIONS ==============
model SupplierSubscription {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  startDate  DateTime @default(now())
  endDate    DateTime @default(dbgenerated("now() + interval '1 month'")) // postgres interval syntax
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ 🛍️ BUYER ================
model Buyer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  card      Card?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============  💳 CARD ===============
model Card {
  id             String   @id @default(uuid())
  tapCardId      String   @unique
  buyerId        String   @unique
  buyer          Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cardHolderName String
  last4          String
  brand          String
  expMonth       Int
  expYear        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// =========== 📁 CATEGORY ==============
model Category {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  parentCategoryId Int?
  parentCategory   Category?  @relation("CategoryToSubcategories", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subcategories    Category[] @relation("CategoryToSubcategories")
  usedFor          ItemType // products or services
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users     UserCategory[]
  suppliers SupplierFavoriteCategory[]
  products  Product[]
  services  Service[]
}

// ===========  🚥 USER_CATEGORY =============
model UserCategory {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
}

// ===========  ⭐️ SUPPLIER_FAVORITE_CATEGORY =============
model SupplierFavoriteCategory {
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([supplierId, categoryId]) // composite PK ensures uniqueness
}

// ============ 🪧 PRODUCT ===============
model Product {
  id                    String                 @id @default(uuid())
  supplierId            String?
  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name                  String                 @db.VarChar(60)
  description           String                 @db.VarChar(1000)
  price                 Float
  stock                 Int                    @default(0)
  categoryId            Int
  category              Category               @relation(fields: [categoryId], references: [id])
  imagesFilesNames      String[]
  caseQuantity          Int                    @default(1)
  minOrderQuantity      Int                    @default(1)
  maxOrderQuantity      Int? // when null it means unlimitid
  allowGroupPurchase    Boolean                @default(false)
  minGroupOrderQuantity Int?
  groupPurchasePrice    Float?
  groupPurchaseDuration GroupPurchaseDeadline?
  isPublished           Boolean                @default(false)
  wishlistCount         Int                    @default(0)
  avgRating             Float                  @default(0.0)
  ratingsCount          Int                    @default(0)
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// ============ ✋ SERVICES ===============
model Service {
  id                  String              @id @default(uuid())
  supplierId          String?
  supplier            Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name                String              @db.VarChar(60)
  description         String              @db.VarChar(1000)
  price               Float
  isPriceNegotiable   Boolean             @default(false)
  categoryId          Int
  category            Category            @relation(fields: [categoryId], references: [id])
  imagesFilesNames    String[]
  serviceAvailability ServiceAvailability
  isPublished         Boolean             @default(false)
  wishlistCount       Int                 @default(0)
  avgRating           Float               @default(0.0)
  ratingsCount        Int                 @default(0)
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

// ============  ⚔️ ENUMS ================

enum UserRole {
  GUEST
  SUPPLIER
  BUYER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TOKEN
}

enum SupplierPlan {
  BASIC
  PREMIUM
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum StoreStatus {
  OPEN
  CLOSED
}

enum GroupPurchaseDeadline {
  THREE_DAYS
  FIVE_DAYS
  SEVEN_DAYS
}

enum ServiceAvailability {
  TWENTY_FOUR_SEVEN
  EVERYDAY 
  WEEKDAYS
  WEEKENDS
  APPOINTMENT
}
