// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============  👤 USER ================
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  crn             String   @unique
  password        String
  name            String
  role            UserRole @default(BUYER)
  businessName    String
  city            String
  nid             String   @unique
  agreedToTerms   Boolean  @default(true)
  isEmailVerified Boolean  @default(false)
  pfpFileName     String?
  isPfpDefault    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tapCustomerId   String   @unique

  categories UserCategory[]
  supplier   Supplier?
  buyer      Buyer?
}

// ============ 🛢 SUPPLIER ==============
model Supplier {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  plan                SupplierPlan @default(BASIC)
  usedFreeTrial       Boolean      @default(false)
  isStoreClosed       Boolean      @default(true)
  storeClosedMsg      String       @default("This store is currently closed. Please check back later.")
  storeBio            String?
  storeBannerFileName String?
  deliveryFees        Float        @default(0.0)
  avgRating           Float        @default(0.0)
  ratingCount         Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  categories SupplierCategory[]
}

// ============ 🛍️ BUYER ================
model Buyer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  card      Card?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============  💳 CARD ===============
model Card {
  id             String   @id @default(uuid())
  tapCardId      String   @unique
  buyerId        String   @unique
  buyer          Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cardHolderName String
  last4          String
  brand          String
  expMonth       Int
  expYear        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// =========== 📁 CATEGORY ==============
model Category {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  parentCategoryId Int?
  parentCategory   Category?  @relation("CategoryToSubcategories", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subcategories    Category[] @relation("CategoryToSubcategories")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users     UserCategory[]
  suppliers SupplierCategory[]
}

// ===========  🚥 USER_CATEGORY =============
model UserCategory {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
}

// ===========  ⭐️ SUPPLIER_CATEGORY =============
model SupplierCategory {
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([supplierId, categoryId])
}

// ============  ⚔️ ENUMS ================

enum UserRole {
  GUEST
  SUPPLIER
  BUYER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TOKEN
}

enum SupplierPlan {
  BASIC
  PREMIUM
}

enum ItemType {
  PRODUCT
  SERVICE
}
