// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============  👤 USER ================
model User {
  id                String    @id @default(uuid())
  tapCustomerId     String    @unique
  email             String    @unique
  crn               String    @unique
  password          String
  name              String
  role              UserRole  @default(BUYER)
  businessName      String
  city              String
  nid               String    @unique
  agreedToTerms     Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  pfpFileName       String?
  isPfpDefault      Boolean   @default(true)
  preferredLanguage Languages @default(EN)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  categories UserCategory[]
  supplier   Supplier?
  buyer      Buyer?
}

// ============ 🛢 SUPPLIER ==============
model Supplier {
  id                  String         @id @default(uuid())
  userId              String         @unique
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  plan                SupplierPlan   @default(BASIC)
  status              SupplierStatus @default(ACTIVE)
  usedFreeTrail       Boolean        @default(false)
  isStoreClosed       Boolean        @default(true)
  storeClosedMsg      String         @default("This store is currently closed. Please check back later.")
  storeBio            String?
  storeBannerFileName String?
  deliveryFees        Float          @default(0.0)
  avgRating           Float          @default(0.0)
  ratingsCount        Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  isDeleted           Boolean        @default(false)
  deletedAt           DateTime?

  categories    SupplierFavoriteCategory[]
  subscriptions SupplierSubscription[]
  products      Product[]
  services      Service[]
  cartGroups    CartBySupplier[] // buyer's cart is grouped based on suppliers
  ordersRecived Order[]
  preInvoicces  PreInvoice[]
  invoices      Invoice[]
}

// ============ 🛂 SUBSCRIPTIONS ==============
model SupplierSubscription {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  startDate  DateTime @default(now())
  endDate    DateTime @default(dbgenerated("now() + interval '1 month'")) // postgres interval syntax
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ 🛍️ BUYER ================
model Buyer {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  card      Card?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carts       Cart[]
  orders      Order[]
  wishlist    Wishlist[]
  preInvoices PreInvoice[]
  invoices    Invoice[]
}

// ============  💳 CARD ===============
model Card {
  id             String   @id @default(uuid())
  tapCardId      String   @unique
  buyerId        String   @unique
  buyer          Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  cardHolderName String
  last4          String
  brand          String
  expMonth       String
  expYear        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// =========== 📁 CATEGORY ==============
model Category {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  parentCategoryId Int?
  parentCategory   Category?  @relation("CategoryToSubcategories", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subcategories    Category[] @relation("CategoryToSubcategories")
  usedFor          ItemType // products or services
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  users     UserCategory[]
  suppliers SupplierFavoriteCategory[]
  products  Product[]
  services  Service[]
}

// ===========  🚥 USER_CATEGORY =============
model UserCategory {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId])
}

// ===========  ⭐️ SUPPLIER_FAVORITE_CATEGORY =============
model SupplierFavoriteCategory {
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([supplierId, categoryId]) // composite PK ensures uniqueness
}

// ============ 🪧 PRODUCT ===============
model Product {
  id                    String                 @id @default(uuid())
  supplierId            String?
  supplier              Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name                  String                 @db.VarChar(60)
  description           String                 @db.VarChar(1000)
  price                 Float
  stock                 Int                    @default(0)
  categoryId            Int
  category              Category               @relation(fields: [categoryId], references: [id])
  imagesFilesNames      String[]
  caseQuantity          Int                    @default(1)
  minOrderQuantity      Int                    @default(1)
  maxOrderQuantity      Int? // when null it means unlimitid
  allowGroupPurchase    Boolean                @default(false)
  minGroupOrderQuantity Int?
  groupPurchasePrice    Float?
  groupPurchaseDuration GroupPurchaseDeadline?
  isPublished           Boolean                @default(false)
  wishlistCount         Int                    @default(0)
  avgRating             Float                  @default(0.0)
  ratingsCount          Int                    @default(0)
  isDeleted             Boolean                @default(false)
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  cartItems    CartItem[]
  invoiceItems InvoiceItem[]
  preInoivces  PreInvoice[]
}

// ============ ✋ SERVICES ===============
model Service {
  id                  String              @id @default(uuid())
  supplierId          String?
  supplier            Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  name                String              @db.VarChar(60)
  description         String              @db.VarChar(1000)
  price               Float
  isPriceNegotiable   Boolean             @default(false)
  categoryId          Int
  category            Category            @relation(fields: [categoryId], references: [id])
  imagesFilesNames    String[]
  serviceAvailability ServiceAvailability
  isPublished         Boolean             @default(false)
  wishlistCount       Int                 @default(0)
  avgRating           Float               @default(0.0)
  ratingsCount        Int                 @default(0)
  isDeleted           Boolean             @default(false)
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  invoiceItems InvoiceItem[]
}

// =========== 🔖 ITEM EMBEDDING ==========
model ItemEmbedding {
  id        String   @id @default(uuid())
  itemId    String
  itemType  ItemType
  embedding Float[] // array of numbers representing the vector
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, itemType]) // each item has exactly one embedding
}

// ============ 🛒 CART =================
model Cart {
  id            String    @id @default(uuid())
  buyerId       String
  buyer         Buyer     @relation(fields: [buyerId], references: [id])
  productsTotal Float
  deliveryFees  Float
  cartTotal     Float
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isBought      Boolean   @default(false)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?

  orders    Order[]
  // A cart can have many suppliers inside it
  suppliers CartBySupplier[]
}

// ============ 🛒 CART BY SUPPLIER =============
model CartBySupplier {
  id                 String   @id @default(uuid())
  cartId             String
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  deliveryFee        Float // of the supplier
  subTotal           Float // sum of this supplier’s items (without delivery fee)
  supplierTotalPrice Float // subTotal + deliveryFee
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  cartItems CartItem[]
}

// ============ 🛒 CART ITEM =============
model CartItem {
  id               Int            @id @default(autoincrement())
  cartBySupplierId String
  cartBySupplier   CartBySupplier @relation(fields: [cartBySupplierId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Int
  itemTotalPrice   Float // product.price * quantity at time of adding
}

// =========== 📦️ ORDER ================
model Order {
  id          String      @id @default(uuid())
  tapChargeId String // same across all orders from the same checkout
  buyerId     String?
  buyer       Buyer?      @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  cartId      String
  cart        Cart        @relation(fields: [cartId], references: [id])
  supplierId  String
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  finalPrice  Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
}

// ============ 🧾 INVOICE ===============
model Invoice {
  id                    String                @id @default(uuid())
  buyerId               String?
  buyer                 Buyer?                @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  supplierId            String?
  supplier              Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  deliveryDate          DateTime
  termsOfPayment        InvoiceTermsOfPayment
  upfrontAmount         Float?
  tapChargeIdForUpfront String?
  tapChargeId           String? // can be null if invoice just created or partially paid
  uponDeliveryAmount    Float 
  amount                Float
  notesAndTerms         String?
  status                InvoiceStatus         @default(PENDING)
  createdAt             DateTime              @default(now())

  items      InvoiceItem[]
  preInvoice PreInvoice? // if created from a preinvoice
}

// ============ 🧾 INVOICE ITEM ===============
model InvoiceItem {
  id                 Int      @id @default(autoincrement())
  invoiceId          String // how is the relation
  invoice            Invoice  @relation(fields: [invoiceId], references: [id])
  name               String   @db.VarChar(60)
  description        String   @db.VarChar(100)
  agreedDetails      String   @db.VarChar(100)
  quantity           Int
  unitPrice          Float
  priceBasedQuantity Float // price * quantity
  relatedServiceId   String?
  relatedService     Service? @relation(fields: [relatedServiceId], references: [id], onDelete: SetNull)
  relatedProductId   String?
  relatedProduct     Product? @relation(fields: [relatedProductId], references: [id], onDelete: SetNull)
}

// ============ 🧾 PRE-INVOICE ===============
model PreInvoice {
  id              String           @id @default(uuid())
  invoiceId       String?          @unique
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  groupPurchaseId String? //TODO: link with groups later
  buyerId         String?
  buyer           Buyer?           @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  amount          Float //TODO: price_based_quantity at Group_Purchase_Bueyrs + delivery fees when linked with groups later
  status          PreInvoiceStatus @default(PENDING)
  createdAt       DateTime         @default(now())
}

// ============ ❤️ WISHLIST ==============
model Wishlist {
  id        String   @id @default(uuid())
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  itemId    String
  itemType  ItemType
  createdAt DateTime @default(now())

  @@unique([buyerId, itemId, itemType])
}

// ============  ⚔️ ENUMS ================

enum UserRole {
  GUEST
  SUPPLIER
  BUYER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TOKEN
}

enum Languages {
  AR
  EN
}

enum SupplierPlan {
  BASIC
  PREMIUM
}

enum ItemType {
  PRODUCT
  SERVICE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum StoreStatus {
  OPEN
  CLOSED
}

enum GroupPurchaseDeadline {
  THREE_DAYS
  FIVE_DAYS
  SEVEN_DAYS
}

enum ServiceAvailability {
  TWENTY_FOUR_SEVEN
  EVERYDAY
  WEEKDAYS
  WEEKENDS
  APPOINTMENT
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  COMPLETED
}

enum PreInvoiceStatus {
  PENDING
  FAILED
  SUCCESSFUL
}

enum InvoiceStatus {
  PENDING
  ACCEPTED
  REJECTED
  FULLY_PAID
  PARTIALLY_PAID
}

enum InvoiceTermsOfPayment {
  PARTIAL
  FULL
}
