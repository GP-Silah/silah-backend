{
    "name": "silah-backend",
    "version": "0.0.1",
    "description": "Backend API server for Silah B2B platform connecting suppliers and buyers. Manages users, products, orders, RFPs, messaging, and integrations with payment gateways and storage services.",
    "author": "Silah Backend Team",
    "private": true,
    "license": "See LICENSE file",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "npm run env:dev:merge && nest start --watch",
        "start:debug": "npm run env:dev:merge && nest start --debug --watch",
        "start:prod": "node dist/src/main",
        "start:test:int": "npm run env:test:merge && dotenv -e .env.merged -- jest -i --no-cache --config ./test/jest-int.json",
        "start:test:e2e": "npm run env:test:merge && dotenv -e .env.merged -- jest -i --no-cache --config ./test/jest-e2e.json",
        "test:cleanup": "npx jest --clearCache",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest --no-coverage",
        "test:watch": "jest --watch --no-coverage",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "npm run env:test:merge && jest --config ./test/jest-e2e.json",
        "pretest:int": "npm run docker:test",
        "pretest:int:watch": "npm run docker:test",
        "test:int": "npm run env:test:merge && jest -i --no-cache --config ./test/jest-int.json",
        "test:int:watch": "npm run env:test:merge && jest -i --watch --no-cache --config ./test/jest-int.json",
        "prisma:seed:category": "ts-node prisma/categorySeed.ts",
        "prisma:dev": "dotenv -e .env.dev -- npx prisma migrate dev",
        "prisma:test": "dotenv -e .env.test -- npx prisma migrate deploy",
        "env:dev:merge": "rm -f .env.merged && cat .env .env.dev > .env.merged",
        "env:test:merge": "rm -f .env.merged && cat .env .env.test > .env.merged",
        "docker:dev": "npm run kill:5432 && npm run docker:cleanup && npm run env:dev:merge && DB_SERVICE=postgres_dev docker compose --env-file .env.merged -f docker/docker-compose.yml -f docker/docker-compose.override.yml up --build app && npm run db:wait:dev",
        "docker:dev:d": "npm run kill:5432 && npm run docker:cleanup && npm run env:dev:merge && DB_SERVICE=postgres_dev docker compose --env-file .env.merged -f docker/docker-compose.yml -f docker/docker-compose.override.yml up --build -d app && npm run db:wait:dev",
        "docker:test": "npm run kill:5432 && npm run docker:cleanup && npm run env:test:merge && DB_SERVICE=postgres_test docker compose --env-file .env.merged -f docker/docker-compose.yml -f docker/docker-compose.override.yml up --build -d app && npm run db:wait:test",
        "db:wait:dev": "npx wait-port 5432 -t 30000",
        "db:wait:test": "npx wait-port 5433 -t 30000",
        "docker:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml down",
        "kill:5432:unix": "sudo lsof -ti:5432 | xargs sudo kill -9 || true",
        "kill:5432:win": "npx kill-port 5432 || echo 'Port cleanup attempted'",
        "kill:5432": "npm run kill:5432:unix || npm run kill:5432:win",
        "kill:5432:cross": "npx kill-port 5432 5433 || true",
        "docker:cleanup": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml down && docker system prune -f",
        "docker:logs:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml logs -f app_dev",
        "docker:logs:test": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml logs -f app_test",
        "docker:logs": "docker compose logs -f"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.864.0",
        "@aws-sdk/s3-request-presigner": "^3.864.0",
        "@godaddy/terminus": "^4.12.1",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/platform-express": "^11.1.6",
        "@nestjs/platform-socket.io": "^11.1.6",
        "@nestjs/schedule": "^6.0.1",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/websockets": "^11.1.6",
        "@prisma/client": "^6.10.1",
        "@types/multer": "^2.0.0",
        "axios": "^1.11.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "file-type": "^16.5.4",
        "multer": "^2.0.2",
        "nodemailer": "^7.0.4",
        "qs": "^6.14.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "sharp": "^0.34.3",
        "socket.io": "^4.8.1",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.18.11",
        "@types/supertest": "^6.0.3",
        "dotenv-cli": "^10.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "kill-port": "^2.0.1",
        "prettier": "^3.4.2",
        "prisma": "^6.10.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "swagger-ui-dist": "^5.25.3",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "wait-port": "^1.1.0"
    },
    "jest": {
        "moduleNameMapper": {
            "src/(.*)": "<rootDir>/src/$1"
        },
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "./",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverage": true,
        "collectCoverageFrom": [
            "src/**/*.{ts,js}",
            "!src/**/*.d.ts",
            "!src/**/index.{ts,js}",
            "!src/**/*.module.ts",
            "!src/**/*.dto.ts",
            "!src/**/*.enum.ts",
            "!src/**/*.docs.ts",
            "!src/main.ts"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "/dist/",
            "/test/"
        ],
        "coverageDirectory": "../coverage",
        "coverageReporters": [
            "text",
            "lcov"
        ],
        "testEnvironment": "node"
    }
}
