{
    "moduleFileExtensions": ["js", "json", "ts"],
    "testEnvironment": "node",
    "testRegex": ".int-spec.ts$",
    "transform": {
        "^.+\\.(t|j)s$": "ts-jest"
    },
    "rootDir": "..",
    "moduleNameMapper": {
        "^src/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": ["<rootDir>/test/jest.setup.ts"]
}
